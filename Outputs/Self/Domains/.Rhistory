dat <- data.frame(
ID = 1:5,
Maths = c(80, 90, 85, 70, 95),
English = c(88, 92, 80, 85, 90),
Science = c(85, 87, 89, 70, 90)
)
print(dat)
dat <- dat %>%
mutate(TotalScore = Maths + English + Science)
library(tidyverse)
dat <- dat %>%
mutate(TotalScore = Maths + English + Science)
print(dat)
filtered_dat <- dat %>%
filter(TotalScore > 250)
print(filtered_dat)
dat <- dat %>%
mutate(MathsGrade = case_when(
Maths >= 90 ~ "A",
Maths >= 80 ~ "B",
Maths >= 70 ~ "C",
Maths >= 60 ~ "D",
TRUE ~ "F"
))
print(dat)

# MBI DOMAINS

domain_list <- paste0("mbiSTotD", 1:5)

# Create a named list to store results
results_domains_self <- lapply(domain_list, function(outcome_var) {
  # Build formulas for each outcome
  form <- make_formula(order = 3, sci_var = "SCI3.3", outcome = outcome_var)
  ziform <- make_ziformula(order = 3, sci_var = "SCI3.3")
  
  # Fit model and return results
  fit_model(formula = form, mbi = mbi, ziformula = ziform)
})

